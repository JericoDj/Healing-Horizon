# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Resend API key for the healinghorizons-mailer Cloud Functions (starts with re_).
# Deployed functions read it from Firebase Secret Manager:
#   firebase functions:secrets:set RESEND_API_KEY --project dignity-with-care
# For the local emulator, also put it in functions/.secret.local.
RESEND_API_KEY=

# true  = forms use the offline mock (fake reference numbers, nothing is sent)
# false = forms call the submitBooking / submitContact Cloud Functions
VITE_FORMS_MOCK=false

# true = in `npm run dev`, send forms to the local Functions emulator (port 5001)
VITE_FIREBASE_EMULATOR=false

# Legacy REST backend for the mock transport in src/services/httpClient.js (unused).
VITE_API_BASE_URL=

# --- Form email routing (website side) --------------------------------------
# Who receives Book a Call / Contact form emails. Comma-separated lists.
# Every address must be on MAIL_ALLOWED in functions/.env, or the function
# drops it. These are public (built into the site), which is why that check exists.
# Restart `npm run dev` / rebuild the site after changing them.
#
# Until healinghorizonsbehavioralmd.net is verified at resend.com/domains, the
# sender must be Resend's test sender, and it only delivers to the email
# address your Resend account was created with.
VITE_MAIL_FROM="Healing Horizons Website <onboarding@resend.dev>"
# After verifying the domain:
# VITE_MAIL_FROM="Healing Horizons Website <website@healinghorizonsbehavioralmd.net>"
VITE_MAIL_TO=info@healinghorizonsbehavioralmd.net
VITE_MAIL_CC=healinghorizonsbh@gmail.com

# --- Firebase web app -------------------------------------------------------
# Firebase console → Project settings → Your apps → "Healing Horizons" (Web).
# Public by design (it ships in the site's JavaScript) but kept out of git.
# Also set these in the hosting provider's environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dignity-with-care.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=dignity-with-care
VITE_FIREBASE_STORAGE_BUCKET=dignity-with-care.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=404595228914
VITE_FIREBASE_APP_ID=
