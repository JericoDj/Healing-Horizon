# Email settings for the healinghorizons-mailer Cloud Functions.
# Copy to functions/.env, fill in, then redeploy:
#   firebase deploy --only functions:healinghorizons-mailer --project dignity-with-care
#
# Day-to-day From / To / CC are set on the WEBSITE (VITE_MAIL_* in the root .env).
# This file holds the safety list and the fallbacks.
# The Resend API key is NOT set here — it lives in Firebase Secret Manager
# (RESEND_API_KEY). Putting it in this file too makes the deploy fail.

# Approved addresses — the ONLY ones the website is allowed to send to or from.
# Comma-separated. A bare domain allows every address at it; a full address
# allows just that one. Add your Resend account's email here to test with it.
# Change this rarely; it is what stops strangers using your Resend account.
MAIL_ALLOWED=healinghorizonsbehavioralmd.net,healinghorizonsbh@gmail.com

# Fallbacks, used when the website sends no usable From / To / CC.
MAIL_FROM="Healing Horizons Website <onboarding@resend.dev>"
MAIL_TO=info@healinghorizonsbehavioralmd.net
MAIL_CC=healinghorizonsbh@gmail.com
