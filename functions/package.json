{
  "name": "healinghorizons-mailer",
  "private": true,
  "description": "Cloud Functions for the Healing Horizons website forms: saves each request to Firestore and emails the practice.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions:healinghorizons-mailer,firestore",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
